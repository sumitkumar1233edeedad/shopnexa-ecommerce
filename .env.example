# ==============================================================================
# DJANGO CORE CONFIGURATION
# ==============================================================================
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# DB_ENV controls which PostgreSQL to use: "local" or "railway"

# --- Local Docker PostgreSQL ---
DB_ENV=local
DB_NAME=ai_store_db
DB_USER=ai_store_user
DB_PASSWORD=ai_store_password
DB_HOST=localhost
DB_PORT=5432

# --- Railway PostgreSQL ---
# DB_ENV=railway
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Used for Celery broker/backend and Django Channels.

# --- Local Docker Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Railway Redis ---
# REDIS_URL=redis://default:password@host:port

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=AI Store <your_email@gmail.com>

# ==============================================================================
# CLOUDINARY STORAGE
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY
# ==============================================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ==============================================================================
# AI ASSISTANT CONFIGURATION (Supports 'groq', 'openai', 'nvidia')
# ==============================================================================
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
