# ==============================================================================
# DJANGO CORE CONFIGURATION
# ==============================================================================
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# In production (Railway), Railway automatically sets DATABASE_URL when PostgreSQL is added.
# For local development: leave empty to use SQLite (db.sqlite3), or provide a PostgreSQL URL.
DATABASE_URL=
# Example: postgresql://postgres:password@localhost:5432/ai_store_db

# ==============================================================================
# REDIS & CELERY CONFIGURATION
# ==============================================================================
# In production (Railway), Railway automatically sets REDIS_URL when Redis is added.
# For local development: leave empty to use in-memory channel layer, or provide a Redis URL.
REDIS_URL=
# Example: redis://default:password@localhost:6379

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=AI Store <your_email@gmail.com>

# ==============================================================================
# CLOUDINARY STORAGE
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY
# ==============================================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
